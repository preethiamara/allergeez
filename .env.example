GEMINI_API_KEY=
# Optional: force a specific Gemini model (otherwise the app tries current models in order)
GEMINI_MODEL=

ELEVENLABS_API_KEY=
# Any premade ElevenLabs voice works on free accounts. This one is "Sarah".
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Neon Postgres (pooled connection string)
DATABASE_URL=postgres://...neon.tech/neondb?sslmode=require

# Neon Auth (optional sign-in). From the Neon console: your branch → Auth.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Bright Data Web Unlocker (optional; food lookups fall back to Open Food Facts without it)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
